{
  "schemaVersion": 2,
  "id": "weekender-claude-v1",
  "status": "frozen",
  "runner": "claude",
  "prompt": "prompt/weekender-v1.md",
  "starter": "starter",
  "runtime": {
    "node": "22",
    "packageManager": "npm"
  },
  "policy": {
    "freshTask": true,
    "followUpMessages": 0,
    "attemptsPerPublishedRun": 1,
    "sandbox": "workspace-write",
    "networkForGeneratedCommands": false,
    "maxDurationMinutes": 45,
    "maxCostUsd": 15,
    "publishFailures": true
  },
  "notes": [
    "Same frozen prompt and starter as weekender-v1, run through Claude Code instead of Codex.",
    "Results are not comparable run-for-run with the Codex roll: different harness, different tool surface, different system prompt. The comparison this roll supports is within itself, across model and effort.",
    "Fable 5's Light and Medium runs were captured first; High, Extra High and Max were captured in a later sitting on the same frozen prompt and starter.",
    "Haiku 4.5 has no effort parameter, so it is recorded off the effort axis as a cost floor rather than assigned a level it never had.",
    "Claude bills thinking inside output tokens and does not report it separately, so reasoning tokens are null for every run in this roll."
  ],
  "configurations": [
    {
      "model": "claude-fable-5",
      "modelLabel": "Fable 5",
      "effort": "low",
      "effortLabel": "Light"
    },
