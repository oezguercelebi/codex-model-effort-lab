{
  "name": "codex-model-effort-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "build:thumbnails": "node scripts/build-thumbnails.mjs",
    "check:site": "node --check site/app.js && node --check scripts/build-site.mjs && node scripts/build-site.mjs",
    "review:calibrate": "node scripts/run-code-review.mjs --calibration",
    "review:checks": "node scripts/run-code-review.mjs --calibration --checks-only",
    "review:light": "node scripts/run-code-review.mjs --effort low --publish --seed weekender-code-review-v1-low-20260720",
    "review:medium": "node scripts/run-code-review.mjs --effort medium --publish --seed weekender-code-review-v1-medium-20260720",
    "review:high": "node scripts/run-code-review.mjs --effort high --publish --seed weekender-code-review-v1-high-20260720",
    "review:xhigh": "node scripts/run-code-review.mjs --effort xhigh --publish --seed weekender-code-review-v1-xhigh-20260714",
    "dry-run": "node scripts/run-benchmark.mjs --model gpt-5.6-luna --effort low --dry-run",
    "roll:claude": "node scripts/run-roll.mjs --benchmark claude-v1.json --concurrency 2",
    "roll:codex": "node scripts/run-roll.mjs --benchmark v1.json --concurrency 2",
    "roll:gemini": "node scripts/run-roll.mjs --benchmark gemini-v1.json --concurrency 2",
    "roll:grok": "node scripts/run-roll.mjs --benchmark grok-v1.json --concurrency 1",
    "dry-run:grok": "node scripts/run-benchmark.mjs --benchmark grok-v1.json --model grok-4.7 --effort medium --dry-run",
    "dry-run:cursor-grok": "node scripts/run-benchmark.mjs --benchmark grok-v1.json --model grok-4.7 --effort medium --dry-run",
    "dry-run:claude": "node scripts/run-benchmark.mjs --benchmark claude-v1.json --model claude-haiku-4-5 --effort none --dry-run",
    "dry-run:gemini": "node scripts/run-benchmark.mjs --benchmark gemini-v1.json --model gemini-3.7-flash --effort high --dry-run",
    "review:claude": "for e in low medium high xhigh max none; do node scripts/run-code-review.mjs --benchmark claude-v1.json --effort $e --publish --resume --seed weekender-claude-code-review-v1-$e-20260806; done"
  },
  "devDependencies": {
    "playwright-core": "1.61.1"
  },
  "engines": {
    "node": ">=22"
  }
}
